# ProofTrace runs fully local with NO API key. These are optional knobs.

# Investigator backend: auto (Ollama if reachable, else deterministic stub) | ollama | stub
PROOFTRACE_LLM=auto
# Validation sandbox: auto (Docker if available, else subprocess) | docker | subprocess
PROOFTRACE_SANDBOX=auto
# Local model served by Ollama (see `ollama list`)
PROOFTRACE_MODEL=qwen2.5-coder:7b
# Ollama endpoint (OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434
